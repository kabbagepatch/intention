{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "intention",
  "version": "0.2.1",
  "identifier": "com.kavish.intention",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Intention",
        "width": 400,
        "height": 500,
        "alwaysOnTop": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMDhFOTc4QjBDMTNDQwpSV1RNRXd5TGw0N2dEV3gwWEZySG9qYWZXZ0lQUzREN1dtZjhiaUxQbS9UOGxwR2l4SmlyamdRcwo=",
      "endpoints": [
        "https://github.com/user/repo/releases/latest/download/latest.json"
      ]
    }
  }
}
